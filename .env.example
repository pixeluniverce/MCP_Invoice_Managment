# Neon: added automatically if you use Vercel's Neon integration (Storage tab)
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string (32+ chars): openssl rand -base64 48
AUTH_SECRET=
# Used once to create tables + first admin: /api/setup?key=<SETUP_KEY>
SETUP_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: overrides the token saved in Settings
WHATSAPP_TOKEN=
